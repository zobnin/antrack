<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/cardview_padding">
<android.support.v7.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/cardview_calls">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/cardview_text_padding2"
        android:background="@color/cardview_bg"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/cardview_calls_number"
            android:layout_alignParentTop="true"
            android:textSize="18sp"
            android:textColor="@color/primary_material_dark"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/cardview_calls_direction"
            android:textColor="@color/primary_material_dark"
            android:text="@string/incoming"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/cardview_calls_time"
            android:layout_below="@+id/cardview_calls_number"
            android:textColor="@color/primary_material_dark"
            />
    </RelativeLayout>
</android.support.v7.widget.CardView>
</LinearLayout>