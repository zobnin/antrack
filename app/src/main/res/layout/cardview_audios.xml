<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/cardview_padding">
    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/cardview_audios"
        android:foreground="?attr/selectableItemBackground"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/cardview_text_padding2"
            android:background="@color/cardview_bg"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/cardview_audios_date"
                android:layout_alignParentTop="true"
                android:textSize="18sp"
                android:textColor="@color/primary_material_dark"
                android:text="00.00.00 00:00:00" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/cardview_audios_length"
                android:layout_below="@+id/cardview_audios_date"
                android:textColor="@color/primary_material_dark"
                android:text="00.00.00" />
        </RelativeLayout>
    </android.support.v7.widget.CardView>
</LinearLayout>